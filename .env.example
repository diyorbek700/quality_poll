# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA-replace-with-your-bot-token

# The ID of the Google spreadsheet (the long string in its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=replace-with-your-spreadsheet-id

# Path to the Google service-account JSON key file.
# Share the spreadsheet with this service account's email as an Editor.
GOOGLE_CREDENTIALS_PATH=./service_account.json
